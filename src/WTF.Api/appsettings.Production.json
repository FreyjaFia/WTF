{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Jwt": {
    "AccessTokenExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  },
  "Storage": {
    "AzureBlob": {
      "Container": "wtf-images"
    }
  },
  "MonthlyReportWorkbookScheduler": {
    "Enabled": true,
    "TimeZoneId": "Asia/Manila",
    "RunAtHour": 0,
    "RunAtMinute": 0,
    "RetryCount": 3,
    "RetryDelayMinutes": 15
  },
  "StaleImageCleanup": {
    "Enabled": true,
    "Categories": [ "users" ],
    "RetentionDays": 30,
    "TimeZoneId": "Asia/Manila",
    "RunAtHour": 2,
    "RunAtMinute": 0,
    "DryRun": false,
    "RemoveRowsWithMissingFile": true,
    "MaxDeletesPerRun": 100,
    "RetryCount": 3,
    "RetryDelayMinutes": 15
  }
}
