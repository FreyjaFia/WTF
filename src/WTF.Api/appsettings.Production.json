{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Jwt": {
    "AccessTokenExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  },
  "Storage": {
    "AzureBlob": {
      "Container": "wtf-images"
    }
  },
  "MonthlyReportWorkbookScheduler": {
    "Enabled": true,
    "TimeZoneId": "Asia/Manila",
    "RunAtHour": 0,
    "RunAtMinute": 0,
    "RetryCount": 3,
    "RetryDelayMinutes": 15
  },
  "ChatImages": {
    "MaxBytes": 5242880,
    "MaxPixelsPerSide": 4096,
    "StoredMaxSide": 1600,
    "JpegQuality": 82,
    "DailyLimitPerCustomer": 30,
    "Container": "wtf-chat-images"
  },
  "ChatRetention": {
    "Enabled": true,
    "MessageDays": 90,
    "TimeZoneId": "Asia/Manila",
    "RunAtHour": 3,
    "RunAtMinute": 0,
    "DryRun": false,
    "BatchSize": 500,
    "MaxDeletesPerRun": 5000,
    "RetryCount": 3,
    "RetryDelayMinutes": 15
  },
  "StaleImageCleanup": {
    "Enabled": true,
    "Categories": [ "users" ],
    "RetentionDays": 30,
    "TimeZoneId": "Asia/Manila",
    "RunAtHour": 2,
    "RunAtMinute": 0,
    "DryRun": false,
    "RemoveRowsWithMissingFile": true,
    "MaxDeletesPerRun": 100,
    "RetryCount": 3,
    "RetryDelayMinutes": 15
  }
}
