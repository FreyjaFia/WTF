            {
              "id": "cheese",
              "quantity": 1
            }
          ]
        },
        {
          "fixedPrice": null,
          "percentOff": 20,
          "requiredAddOns": [
            {
              "id": "cheese",
              "quantity": 1
            }
          ]
        }
      ],
      "expected": {
        "price": 70,
