  "bestDiscount": [
    {
      "name": "a rule whose add-ons match exactly applies",
      "basePrice": 100,
      "cartAddOns": [
        {
          "id": "cheese",
          "quantity": 1
        }
      ],
      "rules": [
        {
          "fixedPrice": null,
          "percentOff": 10,
          "requiredAddOns": [
            {
              "id": "cheese",
              "quantity": 1
            }
          ]
        }
      ],
      "expected": {
        "price": 90,
        "label": "Promo -10%"
      }
    },
    {
      "name": "an extra add-on in the cart blocks the rule",
      "basePrice": 100,
      "cartAddOns": [
        {
          "id": "cheese",
          "quantity": 1
        },
        {
          "id": "bacon",
          "quantity": 1
        }
      ],
      "rules": [
        {
          "fixedPrice": null,
          "percentOff": 10,
          "requiredAddOns": [
            {
              "id": "cheese",
              "quantity": 1
            }
          ]
        }
      ],
      "expected": null
    },
    {
      "name": "a different quantity of the required add-on does not match",
      "basePrice": 100,
      "cartAddOns": [
        {
          "id": "cheese",
          "quantity": 2
