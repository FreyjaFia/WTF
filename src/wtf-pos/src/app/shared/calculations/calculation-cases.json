{
  "_readme": "Sample inputs with the answers both calculators must give. The Angular specs (shared/calculations) and the .NET tests (WTF.Tests/Calculations/SharedCasesTests) load this one file. Change an answer here and both sides must change with it. Prices are pesos with at most two decimals.",
  "orderTotals": [
    {
      "name": "empty order",
      "lines": [],
      "bundles": [],
      "expectedTotal": 0
    },
    {
      "name": "one plain line",
      "lines": [
        {
          "quantity": 2,
          "price": 100,
          "addOns": []
        }
      ],
      "bundles": [],
      "expectedTotal": 200,
      "expectedLineTotals": [200]
    },
    {
      "name": "add-ons are added to each item and multiplied by the line quantity",
      "lines": [
        {
          "quantity": 3,
          "price": 100,
          "addOns": [
            {
              "price": 10,
              "quantity": 1
            },
            {
              "price": 5,
              "quantity": 2
            }
          ]
        }
      ],
      "bundles": [],
      "expectedTotal": 360,
      "expectedLineTotals": [360]
    },
    {
      "name": "an add-on quantity above one multiplies its price",
      "lines": [
        {
          "quantity": 1,
          "price": 80,
          "addOns": [
            {
              "price": 12.5,
              "quantity": 4
            }
          ]
        }
      ],
      "bundles": [],
      "expectedTotal": 130,
      "expectedLineTotals": [130]
    },
    {
      "name": "cents add up exactly (0.10 + 0.20 is 0.30, not 0.30000000000000004)",
      "lines": [
        {
          "quantity": 1,
          "price": 0.1,
          "addOns": []
        },
        {
          "quantity": 1,
          "price": 0.2,
          "addOns": []
        }
      ],
      "bundles": [],
      "expectedTotal": 0.3,
      "expectedLineTotals": [0.1, 0.2]
    },
    {
      "name": "three of an odd price",
      "lines": [
        {
          "quantity": 3,
          "price": 33.33,
          "addOns": []
        }
      ],
      "bundles": [],
      "expectedTotal": 99.99,
      "expectedLineTotals": [99.99]
    },
    {
      "name": "a bundle is sold at its own price and the items inside add nothing",
      "lines": [
        {
          "quantity": 1,
          "price": 50,
          "addOns": []
        }
      ],
      "bundles": [
        {
          "unitPrice": 150,
          "quantity": 2,
          "items": [
            {
              "price": 80,
              "quantity": 1,
              "addOns": []
            },
            {
              "price": 90,
              "quantity": 1,
              "addOns": [
                {
                  "price": 10,
                  "quantity": 1
                }
              ]
            }
          ]
        }
      ],
      "expectedTotal": 350
    },
    {
      "name": "several lines and a bundle",
      "lines": [
        {
          "quantity": 2,
          "price": 120,
          "addOns": [
            {
              "price": 15,
              "quantity": 1
            }
          ]
        },
        {
          "quantity": 1,
          "price": 95.5,
          "addOns": []
        },
        {
          "quantity": 4,
          "price": 60,
          "addOns": [
            {
              "price": 7.25,
              "quantity": 2
            }
          ]
        }
      ],
      "bundles": [
        {
          "unitPrice": 199.99,
          "quantity": 1,
          "items": [
            {
              "price": 100,
              "quantity": 2,
              "addOns": []
            }
          ]
        }
      ],
      "expectedTotal": 863.49,
      "expectedLineTotals": [270, 95.5, 298]
    },
    {
      "name": "a free line (price 0) with a paid add-on",
      "lines": [
        {
          "quantity": 2,
          "price": 0,
          "addOns": [
            {
              "price": 20,
              "quantity": 1
            }
          ]
        }
      ],
      "bundles": [],
      "expectedTotal": 40,
      "expectedLineTotals": [40]
    }
  ],
  "discountedUnitPrice": [
    {
      "name": "fixed amount off",
