      "expected": 95
    },
    {
      "name": "zero fixed amount falls back to the percentage",
      "basePrice": 100,
      "fixedPrice": 0,
      "percentOff": 20,
      "expected": 80
    },
    {
      "name": "100 percent off is free",
      "basePrice": 100,
      "fixedPrice": null,
      "percentOff": 100,
      "expected": 0
    },
    {
      "name": "more than 100 percent never goes below zero",
      "basePrice": 100,
      "fixedPrice": null,
      "percentOff": 150,
      "expected": 0
    },
    {
      "name": "half a centavo rounds up (0.315 -> 0.32)",
      "basePrice": 0.35,
      "fixedPrice": null,
      "percentOff": 10,
      "expected": 0.32
    },
    {
      "name": "half a centavo rounds up (0.135 -> 0.14)",
      "basePrice": 0.15,
      "fixedPrice": null,
      "percentOff": 10,
      "expected": 0.14
    },
    {
      "name": "half a centavo rounds up (9.595 -> 9.60)",
      "basePrice": 10.1,
      "fixedPrice": null,
      "percentOff": 5,
      "expected": 9.6
    },
    {
      "name": "half a centavo rounds up (0.495 -> 0.50)",
      "basePrice": 0.5,
      "fixedPrice": null,
      "percentOff": 1,
      "expected": 0.5
    },
    {
      "name": "under half a centavo rounds down (9.054 -> 9.05)",
      "basePrice": 10.06,
      "fixedPrice": null,
      "percentOff": 10,
      "expected": 9.05
    },
    {
      "name": "no value gives no discount",
      "basePrice": 100,
      "fixedPrice": null,
      "percentOff": null,
      "expected": null
    },
    {
      "name": "zero values give no discount",
      "basePrice": 100,
      "fixedPrice": 0,
      "percentOff": 0,
      "expected": null
    }
